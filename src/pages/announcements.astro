---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import SoftLock from "@components/SoftLock.astro";
import { MEMBER_SOFT_LOCK_PASSWORD, SITE } from "@config";

const announcements = await Promise.all(
  (await getCollection("announcements"))
    .filter(a => !a.data.draft)
    .sort((a, b) => b.data.pubDatetime.valueOf() - a.data.pubDatetime.valueOf())
    .map(async announcement => {
      const { Content } = await announcement.render();
      return { announcement, Content };
    })
);

function formatDate(date: Date) {
  return date.toLocaleDateString("en-US", {
    weekday: "long",
    month: "long",
    day: "numeric",
    year: "numeric",
  });
}
---

<Layout
  title={`Announcements | ${SITE.title}`}
  description="Weekly Spirit Machine announcements for choir members."
>
  <Header activeNav="announcements" />
  <Breadcrumbs />
  <main id="main-content">
    <h1>Announcements</h1>
    <p class="page-desc">
      Weekly updates for members—newest first, all on one page.
    </p>

    <SoftLock
      password={MEMBER_SOFT_LOCK_PASSWORD}
      storageKey="sm-announcements-soft-lock"
      title="Members only"
      hint="Enter the choir password to view weekly announcements. Spacing and capitalization don’t matter."
    >
      {
        announcements.length === 0 ? (
          <p class="empty">No announcements yet.</p>
        ) : (
          announcements.map(({ announcement, Content }) => {
            const anchor = announcement.slug;
            return (
              <article class="announcement" id={anchor}>
                <header class="announcement-header">
                  <h2>
                    <a href={`#${anchor}`}>{announcement.data.title}</a>
                  </h2>
                  <time datetime={announcement.data.pubDatetime.toISOString()}>
                    {formatDate(announcement.data.pubDatetime)}
                  </time>
                </header>
                <div class="prose">
                  <Content />
                </div>
              </article>
            );
          })
        )
      }
    </SoftLock>
  </main>
  <Footer />
</Layout>

<style>
  #main-content {
    @apply mx-auto w-full max-w-3xl px-4 pb-16;
  }
  #main-content h1 {
    @apply text-2xl font-semibold sm:text-3xl;
    font-family: "Fraunces", Georgia, serif;
  }
  .page-desc {
    @apply mb-10 mt-2 italic opacity-80;
  }
  .empty {
    @apply opacity-80;
  }
  .announcement {
    @apply mb-12 border-b border-skin-line pb-10;
  }
  .announcement:last-child {
    @apply mb-0 border-b-0 pb-0;
  }
  .announcement-header {
    @apply mb-4;
  }
  .announcement-header h2 {
    @apply text-xl font-semibold sm:text-2xl;
    font-family: "Fraunces", Georgia, serif;
  }
  .announcement-header h2 a {
    @apply text-skin-base no-underline hover:text-skin-accent;
  }
  .announcement-header time {
    @apply mt-1 block text-sm opacity-70;
  }
</style>

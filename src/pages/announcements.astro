---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import SoftLock from "@components/SoftLock.astro";
import { MEMBER_SOFT_LOCK_PASSWORD, SITE } from "@config";
import communityBulletin from "../data/community-bulletin.html?raw";

const announcements = await Promise.all(
  (await getCollection("announcements"))
    .filter(a => !a.data.draft)
    .sort((a, b) => b.data.pubDatetime.valueOf() - a.data.pubDatetime.valueOf())
    .map(async announcement => {
      const { Content } = await announcement.render();
      return { announcement, Content };
    })
);

const bulletin = communityBulletin.trim();

function formatDate(date: Date) {
  return date.toLocaleDateString("en-US", {
    weekday: "long",
    month: "long",
    day: "numeric",
    year: "numeric",
  });
}
---

<Layout
  title={`Announcements | ${SITE.title}`}
  description="Spirit Machine community bulletin and member announcements."
>
  <Header activeNav="announcements" />
  <Breadcrumbs />
  <main id="main-content">
    <h1>Announcements</h1>
    <p class="page-desc">
      Community bulletin synced from the shared Google Doc—members only.
    </p>

    <SoftLock
      password={MEMBER_SOFT_LOCK_PASSWORD}
      storageKey="sm-announcements-soft-lock"
      title="Members only"
      hint="Enter the choir password to view the community bulletin. Spacing and capitalization don’t matter."
    >
      {
        bulletin ? (
          <article class="bulletin">
            <header class="announcement-header">
              <h2>Community Bulletin</h2>
            </header>
            <div class="bulletin-body" set:html={bulletin} />
          </article>
        ) : (
          <p class="empty">No bulletin content yet.</p>
        )
      }

      {
        announcements.length > 0 && (
          <section class="extra-announcements">
            <h2 class="section-title">Notes</h2>
            {announcements.map(({ announcement, Content }) => {
              const anchor = announcement.slug;
              return (
                <article class="announcement" id={anchor}>
                  <header class="announcement-header">
                    <h2>
                      <a href={`#${anchor}`}>{announcement.data.title}</a>
                    </h2>
                    <time
                      datetime={announcement.data.pubDatetime.toISOString()}
                    >
                      {formatDate(announcement.data.pubDatetime)}
                    </time>
                  </header>
                  <div class="prose">
                    <Content />
                  </div>
                </article>
              );
            })}
          </section>
        )
      }
    </SoftLock>
  </main>
  <Footer />
</Layout>

<style>
  #main-content {
    @apply mx-auto w-full max-w-3xl px-4 pb-16;
  }
  #main-content h1 {
    @apply text-2xl font-semibold sm:text-3xl;
    font-family: "Fraunces", Georgia, serif;
  }
  .page-desc {
    @apply mb-10 mt-2 italic opacity-80;
  }
  .empty {
    @apply opacity-80;
  }
  .bulletin-body {
    @apply text-base leading-relaxed;
  }
  .bulletin-body :global(p) {
    @apply my-3;
  }
  .bulletin-body :global(img) {
    @apply my-4 h-auto max-w-full rounded border border-skin-line;
  }
  .bulletin-body :global(a) {
    @apply text-skin-accent underline decoration-dashed underline-offset-4;
  }
  .section-title {
    @apply mb-6 mt-12 text-xl font-semibold;
    font-family: "Fraunces", Georgia, serif;
  }
  .announcement {
    @apply mb-12 border-b border-skin-line pb-10;
  }
  .announcement:last-child {
    @apply mb-0 border-b-0 pb-0;
  }
  .announcement-header {
    @apply mb-4;
  }
  .announcement-header h2 {
    @apply text-xl font-semibold sm:text-2xl;
    font-family: "Fraunces", Georgia, serif;
  }
  .announcement-header h2 a {
    @apply text-skin-base no-underline hover:text-skin-accent;
  }
  .announcement-header time {
    @apply mt-1 block text-sm opacity-70;
  }
</style>

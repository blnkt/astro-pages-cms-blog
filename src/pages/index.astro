---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import LinkButton from "@components/LinkButton.astro";
import Hr from "@components/Hr.astro";
import Card from "@components/Card";
import Socials from "@components/Socials.astro";
import getSortedPosts from "@utils/getSortedPosts";
import { withBase } from "@utils/path";
import { SOCIALS, TAGLINE } from "@config";

const posts = await getCollection("blog");
const sortedPosts = getSortedPosts(posts);
const recentPosts = sortedPosts.slice(0, 3);

const events = (await getCollection("events")).sort(
  (a, b) => a.data.startDate.valueOf() - b.data.startDate.valueOf()
);
const featuredEvent =
  events.find(e => e.data.featured) ??
  events.find(e => e.data.startDate.valueOf() >= Date.now()) ??
  events[0];

const releases = (await getCollection("music")).sort(
  (a, b) => a.data.order - b.data.order
);
const featuredRelease = releases.find(r => r.data.featured) ?? releases[0];

const socialCount = SOCIALS.filter(social => social.active).length;

function formatEventDate(date: Date) {
  return date.toLocaleString("en-US", {
    weekday: "long",
    month: "long",
    day: "numeric",
    year: "numeric",
    hour: "numeric",
    minute: "2-digit",
  });
}
---

<Layout>
  <Header />
  <main id="main-content">
    <section id="hero">
      <h1>Spirit Machine</h1>
      <p class="tagline">{TAGLINE}</p>
      <p>
        Spirit Machine is a community choir in Portland. We sing an eclectic
        repertoire of supremely good tunes—from Spanish renaissance and South
        African folk-hymns to contemporary pop-gospel and original arrangements
        of Portland-area artists. All experience levels welcome.
      </p>
      {
        socialCount > 0 && (
          <div class="social-wrapper">
            <div class="social-links">Find us:</div>
            <Socials />
          </div>
        )
      }
    </section>

    {
      featuredEvent && (
        <>
          <Hr />
          <section id="up-next">
            <h2>Up next</h2>
            <article class="feature-card">
              <h3>
                <a href={withBase(`/events/${featuredEvent.slug}/`)}>
                  {featuredEvent.data.title}
                </a>
              </h3>
              <p class="meta">
                {formatEventDate(featuredEvent.data.startDate)}
                {" · "}
                {featuredEvent.data.venue}
                {featuredEvent.data.location
                  ? `, ${featuredEvent.data.location}`
                  : ""}
              </p>
              <p>{featuredEvent.data.summary}</p>
              <LinkButton href={withBase(`/events/${featuredEvent.slug}/`)}>
                Event details
                <svg xmlns="http://www.w3.org/2000/svg">
                  <path d="m11.293 17.293 1.414 1.414L19.414 12l-6.707-6.707-1.414 1.414L15.586 11H6v2h9.586z" />
                </svg>
              </LinkButton>
            </article>
          </section>
        </>
      )
    }

    {
      featuredRelease && (
        <>
          <Hr />
          <section id="featured-release">
            <h2>Featured release</h2>
            <article class="feature-card release">
              {featuredRelease.data.coverImage && (
                <img
                  src={withBase(featuredRelease.data.coverImage)}
                  alt=""
                  width="120"
                  height="120"
                />
              )}
              <div>
                <h3>{featuredRelease.data.title}</h3>
                <p class="meta">
                  {featuredRelease.data.releaseType} ·{" "}
                  {featuredRelease.data.year}
                </p>
                {featuredRelease.data.listenUrl && (
                  <LinkButton
                    href={featuredRelease.data.listenUrl}
                    className="underline decoration-dashed underline-offset-4"
                  >
                    Listen
                  </LinkButton>
                )}
              </div>
            </article>
            <p class="more">
              <LinkButton href={withBase("/music/")}>All music →</LinkButton>
            </p>
          </section>
        </>
      )
    }

    {
      recentPosts.length > 0 && (
        <>
          <Hr />
          <section id="recent-posts">
            <h2>News</h2>
            <ul>
              {recentPosts.map(({ data, slug }) => (
                <Card
                  href={withBase(`/posts/${slug}/`)}
                  frontmatter={data}
                  secHeading={false}
                />
              ))}
            </ul>
            <div class="all-posts-btn-wrapper">
              <LinkButton href={withBase("/posts/")}>
                All news
                <svg xmlns="http://www.w3.org/2000/svg">
                  <path d="m11.293 17.293 1.414 1.414L19.414 12l-6.707-6.707-1.414 1.414L15.586 11H6v2h9.586z" />
                </svg>
              </LinkButton>
            </div>
          </section>
        </>
      )
    }
  </main>
  <Footer />
</Layout>

<style>
  #main-content {
    @apply mx-auto w-full max-w-3xl pb-12;
  }
  #hero {
    @apply pb-6 pt-8;
  }
  #hero h1 {
    @apply my-4 inline-block text-3xl font-bold sm:my-8 sm:text-5xl;
    font-family: "Fraunces", Georgia, serif;
  }
  .tagline {
    @apply mb-4 text-lg italic text-skin-base opacity-80;
  }
  .social-wrapper {
    @apply mt-4 flex flex-col flex-wrap items-center justify-center sm:flex-row sm:items-center;
  }
  .social-links {
    @apply mb-1 mr-2 whitespace-nowrap sm:mb-0;
  }
  #up-next h2,
  #featured-release h2,
  #recent-posts h2 {
    @apply text-2xl font-semibold tracking-wide;
    font-family: "Fraunces", Georgia, serif;
  }
  .feature-card {
    @apply my-4 rounded border border-skin-line bg-skin-card bg-opacity-40 p-4;
  }
  .feature-card h3 {
    @apply text-xl font-medium text-skin-accent;
  }
  .feature-card .meta {
    @apply my-2 text-sm opacity-80;
  }
  .feature-card.release {
    @apply flex gap-4;
  }
  .feature-card.release img {
    @apply shrink-0 rounded border border-skin-line;
  }
  .more {
    @apply mt-2;
  }
  .all-posts-btn-wrapper {
    @apply my-8 text-center;
  }
</style>

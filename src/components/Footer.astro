---
import Hr from "./Hr.astro";
import Socials from "./Socials.astro";
import { withBase } from "@utils/path";
import { CONTACT_EMAIL } from "@config";

const currentYear = new Date().getFullYear();

export interface Props {
  noMarginTop?: boolean;
}

const { noMarginTop = false } = Astro.props;
---

<footer class={`${noMarginTop ? "" : "mt-auto"}`}>
  <Hr noPadding />
  <div class="footer-wrapper">
    <div class="footer-links">
      <a href={withBase("/support/")}>Donate</a>
      <a href={withBase("/contact/")}>Contact</a>
      <a href={`mailto:${CONTACT_EMAIL}`}>Email</a>
    </div>
    <Socials centered />
    <div class="copyright-wrapper">
      <span>Copyright &#169; {currentYear} Spirit Machine</span>
    </div>
  </div>
</footer>

<style>
  footer {
    @apply w-full;
  }
  .footer-wrapper {
    @apply flex flex-col items-center gap-3 py-6;
  }
  .footer-links {
    @apply flex flex-wrap justify-center gap-4 text-sm;
  }
  .footer-links a {
    @apply hover:text-skin-accent;
  }
  .link-button {
    @apply my-1 p-2 hover:rotate-6;
  }
  .link-button svg {
    @apply scale-125;
  }
  .copyright-wrapper {
    @apply my-2 text-sm opacity-80;
  }
</style>
